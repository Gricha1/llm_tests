TWITCH_BOT_NICK=
TWITCH_OAUTH=
TWITCH_CHANNEL=

# Helix API (followers + chatters). Scopes:
# moderator:read:followers, moderator:read:chatters
TWITCH_CLIENT_ID=
TWITCH_USER_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_MODERATOR_ID=

LOCAL_DEBUG_BYPASS_FOLLOWER_CHECK=true
FOLLOWER_CACHE_SECONDS=600
WATCHTIME_TICK_SECONDS=60
DO_COOLDOWN_SECONDS=10
STREAMING_SURVIVAL_STAGE_SECONDS=180

UNITY_HOST=127.0.0.1
UNITY_PORT=5055
UNITY_TRANSPORT=udp

USE_LOCAL_LLM=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=20

BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=8765

LISTEN_STREAM_ON_START=false

VOTE_DURATION_SECONDS=60
AUTO_POLL_INTERVAL_SECONDS=600
EMPTY_POLL_POLICY=do_nothing
CHAT_TIPS_INTERVAL_SECONDS=180
WELCOME_ON_START=true

GLOBAL_COMMAND_COOLDOWN_SECONDS=30
USER_COMMAND_COOLDOWN_SECONDS=120

DB_PATH=stream_bot.sqlite3
