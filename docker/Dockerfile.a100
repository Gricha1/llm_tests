## Local docker image for running AEnt/verl on NVIDIA A100 (Ampere).
##
## Notes for A100 80GB + driver 580.x / CUDA 12.4+:
## - Host driver 580 supports PyTorch cu124 wheels (unlike older TITAN + driver 535).
## - 80GB VRAM per GPU: less fragmentation pressure than 24GB TITAN; keep expandable_segments anyway.
## - vLLM is not installed by default (same as TITAN image); use rollout.name=hf or extend this Dockerfile.
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_ROOT_USER_ACTION=ignore
ENV HF_HUB_ENABLE_HF_TRANSFER=1
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# python3-dev: Python.h for Triton / torch.compile backends that compile auxiliary C extensions at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates \
    python3 python3-pip python3-venv python3-dev \
    build-essential ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel

# PyTorch CUDA 12.4 wheels (Ampere A100; matches base image and modern drivers).
RUN pip install --no-cache-dir \
    "torch==2.4.0" "torchvision==0.19.0" "torchaudio==2.4.0" --index-url https://download.pytorch.org/whl/cu124 && \
    pip install --no-cache-dir \
    accelerate datasets peft "transformers==4.46.3" \
    ray[default] hydra-core codetiming \
    "tensordict<=0.6.2" torchdata \
    numpy "pyarrow>=19.0.0" pandas \
    dill pybind11 pylatexenc packaging \
    wandb tensorboard fastapi uvicorn hf_transfer \
    math_verify liger-kernel

RUN pip install --no-cache-dir --force-reinstall \
    "torch==2.4.0" "torchvision==0.19.0" "torchaudio==2.4.0" \
    --index-url https://download.pytorch.org/whl/cu124

RUN pip install --no-cache-dir --force-reinstall "transformers==4.46.3"

# AEnt MATH: clamp_entropy + use_remove_padding need flash_attn.bert_padding (see ray_aent_trainer).
RUN pip install --no-cache-dir flash-attn --no-build-isolation || \
    echo "WARN: flash-attn install failed; set use_remove_padding=False and clamp_entropy=False"

RUN pip install --no-cache-dir tensorboard comet_ml

# Official MATH recipe uses vLLM rollout (see run_aent_q1b5_math.sh). Pin matches setup.py.
RUN pip install --no-cache-dir "vllm<=0.8.5" || \
    echo "WARN: vllm install failed; use rollout.name=hf with HF_ROLLOUT_MICRO_BATCH=1"

WORKDIR /workspace/aent
